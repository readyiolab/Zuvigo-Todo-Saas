# App
APP_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=change-me-to-a-long-random-string

# MySQL (source of truth)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=zuvigotodo

# Redis / Upstash (optional — leave empty to use MySQL-only sessions)
REDIS_URL=

# DigitalOcean Spaces (file uploads) — use real values only in .env.local / server env
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_SPACES_CDN_ENDPOINT=
MAX_UPLOAD_BYTES=26214400
NEXT_PUBLIC_MAX_UPLOAD_BYTES=26214400

# Optional / future
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_FROM=noreply@example.com
